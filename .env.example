# Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks

# App config (host "localhost" = running the app locally, db/redis published by compose)
# docker compose overrides these with the service hostnames db / redis
# Where the app finds Postgres. The user, password and database above are used too, so the
# login is written only once. "localhost:5433" is the port Docker publishes on your machine;
# docker compose sets host "db" and port 5432 for the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Seconds a cached item lives. The list changes often, a single task less often.
LIST_CACHE_TTL=30
TASK_CACHE_TTL=120
# Seconds an unknown task id is remembered, so repeated requests skip the database.
NOT_FOUND_CACHE_TTL=10

# Host port for the API (change if 8000 is already in use)
APP_PORT=8010

# Redis password. Generate one with: openssl rand -hex 16
# Use only letters and digits so it is safe inside the URLs below.
REDIS_PASSWORD=changeme
# A different password for the cache Redis. Someone who reaches the cache cannot use it on
# the Redis that holds the event stream and the job queue. Letters and digits only.
CACHE_REDIS_PASSWORD=cachesecret

# Redis URLs: format redis://:PASSWORD@host:port/db (note the ":" before the password).
# Cache and event stream use db 0. Celery broker (job queue) and result backend use separate dbs.
REDIS_URL=redis://:changeme@localhost:6379/0
# Separate Redis server for the task cache (port 6380). It may drop old keys when full.
CACHE_REDIS_URL=redis://:cachesecret@localhost:6380/0
CELERY_BROKER_URL=redis://:changeme@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@localhost:6379/2

# Login for the Flower page (http://localhost:5555), format user:password
FLOWER_BASIC_AUTH=admin:changeme

# Folder where the export job writes CSV files (a shared volume in docker compose)
EXPORT_DIR=exports

# Stable name of the stream worker in its consumer group (empty = hostname-pid).
# Give every worker its own name if you run more than one.
CONSUMER_NAME=

# Set to false to hide /docs and /openapi.json (for example in production).
DOCS_ENABLED=true

# Export files older than this many hours are deleted by the hourly cleanup job.
EXPORT_RETENTION_HOURS=24

# Only one export runs at a time. If the worker dies, the lock frees itself after this long.
EXPORT_LOCK_SECONDS=900

# Application settings (config.py reads these; there are no defaults in code)
# Starts every cache, job and seen-event key, so two apps can share one Redis.
# Include the trailing ":". Use a different value per environment (dev, test, prod).
KEY_PREFIX=taskapi:dev:
# Redis Stream that task events are sent to.
EVENT_STREAM=events:tasks
# Stream length that Redis trims to (approximately). Unread events beyond this are lost,
# so keep it far above any backlog. A Beat job logs an error at 80% full.
EVENT_STREAM_MAXLEN=100000
# Seconds to wait for Redis before giving up.
REDIS_TIMEOUT=1.0
# Most connections each Redis client may open.
REDIS_MAX_CONNECTIONS=20
# Dead-letter stream length that Redis trims to (approximately).
DEAD_STREAM_MAXLEN=1000
# How often the relay job runs, in seconds.
OUTBOX_POLL_SECONDS=2.0
# Outbox rows sent per relay run.
OUTBOX_BATCH_SIZE=50
# Tries before an invalid outbox event is marked dead.
OUTBOX_MAX_BAD_ATTEMPTS=5
# Days to keep sent outbox rows.
OUTBOX_RETENTION_DAYS=7
# Consumer group of the stream worker.
CONSUMER_GROUP=task-workers
# How long to wait for a new event, in ms.
CONSUMER_BLOCK_MS=5000
# Events read at once.
CONSUMER_BATCH_SIZE=10
# How long a handled event id is remembered.
CONSUMER_SEEN_TTL_SECONDS=86400
# Idle time before a stuck event is taken over, in ms.
CONSUMER_MIN_IDLE_MS=60000
# Tries before an event goes to the dead-letter stream.
CONSUMER_MAX_DELIVERIES=3
# How long Celery keeps a job result and job id.
JOB_RESULT_TTL_SECONDS=3600
# Larger request bodies get 413.
MAX_BODY_BYTES=1000000
# Secret for the X-API-Key header. Every route except /health needs it.
# Generate one with: openssl rand -hex 24
API_KEY=changeme
# Addresses of the reverse proxies uvicorn trusts for X-Forwarded-* headers (comma separated).
# Use the proxy's address. Do not use "*" in production.
FORWARDED_ALLOW_IPS=127.0.0.1
