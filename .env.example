# Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks

# App config (host "localhost" = running the app locally, db/redis published by compose)
# docker compose overrides these two with the service hostnames db / redis
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/tasks
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=60

# Host port for the API (change if 8000 is already in use)
APP_PORT=8010
